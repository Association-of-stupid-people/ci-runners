# Site settings. Edit, commit if they are not secret; the GitHub token is never stored here.
# Org (https://github.com/<org>) or a single repo (https://github.com/<owner>/<repo>); a personal account has
# no org level, so its runners are registered per repo.
GITHUB_CONFIG_URL=https://github.com/Association-of-stupid-people
# Sized scale sets, one per entry <cores>c<GiB>g -> runner label ci-<cores>c-<GiB>g (e.g. 4c8g -> ci-4c-8g).
# Kubernetes packs them by free cores and memory, e.g. 8 cores / 8 GiB free fits 4 x ci-2c-2g, 2 x ci-4c-4g
# or 1 x ci-8c-8g; jobs that do not fit wait in the queue. Empty = none.
CI_SIZES="2c2g 4c4g 4c8g 8c8g"
